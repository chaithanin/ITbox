# ==========================================================
# ITBox — Enterprise IT Management System
# Environment variables template.
# Copy to .env for local development.
# In production, ALL secrets must come from Google Secret Manager
# (injected into Cloud Run as env vars / mounted secrets).
# NEVER commit a real .env file.
# ==========================================================

# --- Database (Cloud SQL for PostgreSQL) ---
# Local:      postgresql://itbox:password@localhost:5432/itbox
# Cloud Run:  postgresql://USER:PASSWORD@localhost/itbox?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# --- Auth.js / NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the app, e.g. https://itbox.example.com
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Google OAuth (Google Workspace / Cloud Identity) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft Entra ID (optional SSO) ---
# Set NEXT_PUBLIC_AUTH_ENTRA=1 to show the sign-in button in the UI.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
NEXT_PUBLIC_AUTH_ENTRA=

# --- GCP ---
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1

# --- File storage ---
# STORAGE_PROVIDER: "gcs" (production) | "local" (development only)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.uploads
GCS_BUCKET_ASSETS=
GCS_BUCKET_DOCUMENTS=
GCS_BUCKET_REPORTS=

# --- Scheduled checks (Cloud Scheduler) ---
# openssl rand -base64 24 — sent as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Cloud KMS (Vault envelope encryption) ---
# KMS_PROVIDER: "gcp" (production) | "local" (development only)
KMS_PROVIDER=local
KMS_KEY_RING=itbox-vault
KMS_CRYPTO_KEY=vault-dek-wrapper
KMS_LOCATION=asia-southeast1
# LOCAL ONLY — dev master key for envelope encryption when KMS_PROVIDER=local.
# Generate with: openssl rand -base64 32
# MUST NOT be used in production. Production uses Cloud KMS.
LOCAL_KMS_MASTER_KEY=

# --- LINE Messaging API (notifications) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- SMTP (email notifications, optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Seed (development / first install only) ---
# Passwords for seeded demo users. Required to run `npm run db:seed`.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
