// ITBox — Enterprise IT Management System
// PostgreSQL + Prisma. Multi-tenant: every business table carries organizationId.
// Vault secrets are stored ONLY as AES-256-GCM ciphertext with a KMS-wrapped DEK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Tenancy
// ============================================================

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  taxId     String?
  address   String?
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users             User[]
  roles             Role[]
  employees         Employee[]
  simCards          SimCard[]
  departments       Department[]
  locations         Location[]
  assetCategories   AssetCategory[]
  assets            Asset[]
  vaultCategories   VaultCategory[]
  vaultItems        VaultItem[]
  licenses          License[]
  subscriptions     Subscription[]
  vendors           Vendor[]
  purchaseRequests  PurchaseRequest[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  systemSettings    SystemSetting[]
  maintenanceTickets MaintenanceTicket[]
  offboardings      Offboarding[]
  supportCases      SupportCase[]
  caseTypes         CaseType[]
  caseCategories    CaseCategory[]
  slaPolicies       SlaPolicy[]
  supportTeams      SupportTeam[]
  holidays          Holiday[]
  kpiConfigs        KpiConfig[]
  signatureTemplates SignatureTemplate[]
  itHealthChecks    ItHealthCheck[]
  signatureProfiles  SignatureProfile[]
  networkDevices    NetworkDevice[]
  vlans             Vlan[]
  subnets           Subnet[]
  ipAddresses       IpAddress[]
  changeRequests    ChangeRequest[]
  backupJobs        BackupJob[]
  contracts         Contract[]
  problems          Problem[]
  kbArticles        KbArticle[]
  vulnerabilities   Vulnerability[]
  configItems       ConfigurationItem[]
  ciRelationships   CiRelationship[]
  onboardings       Onboarding[]
  serviceCatalog    ServiceCatalogItem[]
  endpointPostures  EndpointPosture[]
  monitoringHosts   MonitoringHost[]
  cctvRecorders     CctvRecorder[]
  cctvCameras       CctvCamera[]
  cctvHealthLogs    CctvHealthLog[]
  cctvStorageLogs   CctvStorageLog[]
  cctvIncidents     CctvIncident[]

  @@map("organizations")
}

// ============================================================
// Identity / RBAC
// ============================================================

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  email          String     @unique
  name           String
  image          String?
  // Argon2id hash — never plaintext. Null for OAuth-only users.
  passwordHash   String?
  status         UserStatus @default(ACTIVE)

  // MFA (TOTP). Secret is encrypted with the org KMS envelope, never plaintext.
  mfaEnabled       Boolean @default(false)
  totpSecretEnc    String?
  // Last accepted TOTP time-step, to reject code replay within its window
  totpLastStep     BigInt?
  totpSecretDekEnc String?

  // Login protection
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  // Recent Argon2id password hashes (most-recent first, capped) to prevent
  // reuse on change/reset — see AUTH-006. Never plaintext.
  passwordHistory  String[]  @default([])

  // HR employee code (staff ID). Links a login account to its HR employee
  // record for deterministic reconciliation — see lib/hr-user-link.ts. Nullable
  // (not every account is an employee), unique per org.
  employeeCode String?

  // Language / theme preferences
  locale String @default("th")
  // How the post-login KPI popup behaves for this user: DAILY | EVERY_LOGIN | OFF
  kpiPopupMode String @default("DAILY")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee?
  userRoles    UserRole[]
  sessions     UserSession[]
  accounts     OAuthAccount[]
  webauthnCredentials WebAuthnCredential[]

  vaultItemsOwned    VaultItem[]     @relation("VaultOwner")
  vaultSharesGranted VaultShare[]    @relation("SharedBy")
  vaultSharesReceived VaultShare[]   @relation("SharedWithUser")
  vaultFavorites     VaultFavorite[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  approvalsAssigned  Approval[]      @relation("Approver")
  emergencyRequests  VaultEmergencyRequest[] @relation("EmergencyRequester")
  casesRequested     SupportCase[]   @relation("CaseRequester")
  casesCreated       SupportCase[]   @relation("CaseCreatedBy")
  casesAssigned      SupportCase[]   @relation("CaseAssignee")
  casesCommanded     SupportCase[]   @relation("CaseCommander")
  caseComments       CaseComment[]
  supportTeamMemberships SupportTeamMember[]
  signatureProfile   SignatureProfile?

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@map("users")
}

// WebAuthn / Passkey credentials (public keys only — no secrets stored)
model WebAuthnCredential {
  id         String    @id // credential ID (base64url)
  userId     String    @db.Uuid
  publicKey  String // base64url COSE public key
  counter    BigInt    @default(0)
  transports String[]  @default([])
  deviceType String?
  backedUp   Boolean   @default(false)
  name       String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

// Short-lived server-side WebAuthn ceremony challenges (multi-instance safe)
model WebAuthnChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String // REGISTRATION | AUTHENTICATION
  challenge String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@map("webauthn_challenges")
}

model OAuthAccount {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  provider          String
  providerAccountId String
  type              String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenId    String    @unique // jti in the JWT
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Role {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  // Machine key, e.g. SUPER_ADMIN, IT_MANAGER
  key            String
  name           String
  nameTh         String?
  description    String?
  isSystem       Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  vaultShares     VaultShare[]     @relation("SharedWithRole")

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  // e.g. asset:create, vault:reveal, vault:manage
  key         String @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ============================================================
// Organization structure
// ============================================================

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  OFFBOARDING
  RESIGNED
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  employeeCode   String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  position       String?
  status         EmployeeStatus @default(ACTIVE)
  startDate      DateTime?
  endDate        DateTime?

  departmentId String? @db.Uuid
  locationId   String? @db.Uuid
  managerId    String? @db.Uuid
  userId       String? @unique @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  manager      Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports      Employee[]   @relation("EmployeeManager")
  user         User?        @relation(fields: [userId], references: [id])

  assetAssignments   AssetAssignment[]
  licenseAssignments LicenseAssignment[]
  offboardings       Offboarding[]
  onboardings        Onboarding[]
  supportCases       SupportCase[]  @relation("CaseRequesterEmployee")
  borrowRequests     BorrowRequest[] @relation("BorrowRequester")
  simCards           SimCard[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, departmentId])
  @@map("employees")
}

model Department {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  code           String
  name           String
  division       String?
  costCenter     String?
  managerId      String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  assets       Asset[]
  vaultItems   VaultItem[]
  vaultShares  VaultShare[] @relation("SharedWithDepartment")
  purchaseRequests PurchaseRequest[]
  supportCases SupportCase[] @relation("CaseDepartment")
  borrowRequests BorrowRequest[]
  simCards     SimCard[]

  @@unique([organizationId, code])
  @@map("departments")
}

model Location {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  code           String
  name           String
  address        String?
  building       String?
  floor          String?
  room           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  assets       Asset[]
  supportCases SupportCase[] @relation("CaseLocation")
  itHealthChecks ItHealthCheck[]
  networkDevices NetworkDevice[]
  vlans        Vlan[]
  subnets      Subnet[]
  cctvRecorders CctvRecorder[]

  @@unique([organizationId, code])
  @@map("locations")
}

// ============================================================
// Assets
// ============================================================

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  IN_USE
  RESERVED
  BORROWED
  IN_REPAIR
  LOST
  STOLEN
  DAMAGED
  RETIRED
  DISPOSED
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
  CRITICAL
}

model AssetCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  nameTh         String?
  parentId       String? @db.Uuid
  icon           String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  parent       AssetCategory?  @relation("CategoryParent", fields: [parentId], references: [id])
  children     AssetCategory[] @relation("CategoryParent")
  assets       Asset[]

  @@unique([organizationId, name])
  @@map("asset_categories")
}

model Asset {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  assetTag       String
  serialNumber   String?
  name           String
  brand          String?
  model          String?
  specification  String?
  purchaseDate   DateTime?
  purchasePrice  Decimal?       @db.Decimal(14, 2)
  currentValue   Decimal?       @db.Decimal(14, 2)
  depreciationMonths Int?
  invoiceNumber  String?
  warrantyStart  DateTime?
  warrantyEnd    DateTime?
  status         AssetStatus    @default(AVAILABLE)
  condition      AssetCondition @default(NEW)
  costCenter     String?
  project        String?
  notes          String?
  imageUrl       String?
  ipAddress      String?
  macAddress     String?
  imei           String?

  categoryId   String? @db.Uuid
  departmentId String? @db.Uuid
  locationId   String? @db.Uuid
  vendorId     String? @db.Uuid
  // Employee currently holding the asset (denormalized from open assignment)
  assignedToId String? @db.Uuid
  custodian    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  category     AssetCategory? @relation(fields: [categoryId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  location     Location?      @relation(fields: [locationId], references: [id])
  vendor       Vendor?        @relation(fields: [vendorId], references: [id])

  assignments AssetAssignment[]
  transfers   AssetTransfer[]
  history     AssetHistory[]
  documents   AssetDocument[]
  maintenance MaintenanceTicket[]
  vaultLinks  AssetVaultLink[]
  vulnerabilities Vulnerability[]
  configItems ConfigurationItem[]
  endpointPostures EndpointPosture[]
  cctvRecorders CctvRecorder[]
  borrowItems BorrowRequestItem[]

  @@unique([organizationId, assetTag])
  supportCases SupportCase[]  @relation("CaseAsset")

  @@index([organizationId, status])
  @@index([organizationId, categoryId])
  @@index([organizationId, departmentId])
  @@index([organizationId, serialNumber])
  @@map("assets")
}

enum AssignmentStatus {
  CHECKED_OUT
  RETURNED
}

model AssetAssignment {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  assetId        String           @db.Uuid
  employeeId     String           @db.Uuid
  status         AssignmentStatus @default(CHECKED_OUT)

  assignedAt         DateTime        @default(now())
  assignedById       String?         @db.Uuid
  purpose            String?
  expectedReturnDate DateTime?
  conditionBefore    AssetCondition?

  returnedAt     DateTime?
  returnedById   String?         @db.Uuid
  conditionAfter AssetCondition?
  damageNotes    String?
  remark         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([organizationId, assetId])
  @@index([organizationId, employeeId, status])
  @@map("asset_assignments")
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model AssetTransfer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  assetId        String         @db.Uuid
  fromDepartmentId String?      @db.Uuid
  toDepartmentId   String?      @db.Uuid
  fromLocationId   String?      @db.Uuid
  toLocationId     String?      @db.Uuid
  fromEmployeeId   String?      @db.Uuid
  toEmployeeId     String?      @db.Uuid
  reason         String?
  status         TransferStatus @default(PENDING)
  requestedById  String?        @db.Uuid
  approvedById   String?        @db.Uuid
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([organizationId, assetId])
  @@map("asset_transfers")
}

model AssetHistory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  assetId        String   @db.Uuid
  action         String // PURCHASE, REGISTER, ASSIGN, RETURN, TRANSFER, REPAIR, RETIRE, DISPOSE, ...
  detail         String?
  actorId        String?  @db.Uuid
  createdAt      DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([organizationId, assetId, createdAt])
  @@map("asset_history")
}

model AssetDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  assetId        String   @db.Uuid
  name           String
  type           String // INVOICE, WARRANTY, MANUAL, PHOTO, OTHER
  storagePath    String // GCS object path
  contentType    String?
  sizeBytes      Int?
  uploadedById   String?  @db.Uuid
  createdAt      DateTime @default(now())
  deletedAt      DateTime?

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([organizationId, assetId])
  @@map("asset_documents")
}

// ============================================================
// Password / Secret Vault (envelope-encrypted)
// ============================================================

enum SecretClassification {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VaultItemType {
  PASSWORD
  SERVER
  DATABASE
  API_KEY
  SSH_KEY
  WIFI
  NETWORK_DEVICE
  CERTIFICATE
  LICENSE_KEY
  TOKEN
  OTHER
}

model VaultCategory {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  nameTh         String?
  icon           String?
  isSystem       Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  items        VaultItem[]

  @@unique([organizationId, name])
  @@map("vault_categories")
}

// Sensitive fields are ONLY stored encrypted (AES-256-GCM, per-item DEK
// wrapped by Cloud KMS). Metadata (name, category, classification, host...)
// stays plaintext for search — never the secret values themselves.
model VaultItem {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String
  type           VaultItemType        @default(PASSWORD)
  classification SecretClassification @default(MEDIUM)
  categoryId     String?              @db.Uuid
  departmentId   String?              @db.Uuid
  ownerId        String?              @db.Uuid
  environment    String? // Production / Staging / Development
  url            String?
  host           String?
  port           Int?
  protocol       String?
  username       String? // login name is metadata (searchable), not secret
  tags           String[]             @default([])
  notes          String?

  // --- Encrypted payload (JSON of secret fields) ---
  // ciphertext = AES-256-GCM(secretJson, DEK); dekEnc = KMS-wrapped DEK
  ciphertext          String
  iv                  String
  authTag             String
  dekEnc              String
  kmsKeyVersion       String?
  encryptionAlgorithm String  @default("AES-256-GCM")

  // Rotation policy
  rotationDays  Int?
  lastRotatedAt DateTime?
  nextRotationAt DateTime?
  expiresAt     DateTime?

  // Policy: require MFA to reveal (defaults on for HIGH/CRITICAL)
  requireMfaToReveal Boolean @default(false)
  requireApprovalToReveal Boolean @default(false)

  createdById String? @db.Uuid
  updatedById String? @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  category     VaultCategory? @relation(fields: [categoryId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  owner        User?          @relation("VaultOwner", fields: [ownerId], references: [id])

  shares       VaultShare[]
  accessLogs   VaultAccessLog[]
  rotationLogs VaultRotationLog[]
  emergencyRequests VaultEmergencyRequest[]
  assetLinks   AssetVaultLink[]
  favorites    VaultFavorite[]

  @@index([organizationId, categoryId])
  @@index([organizationId, ownerId])
  @@index([organizationId, name])
  @@index([organizationId, nextRotationAt])
  @@map("vault_items")
}

// Link between an Asset and its related credentials
model AssetVaultLink {
  assetId     String   @db.Uuid
  vaultItemId String   @db.Uuid
  label       String? // e.g. "Windows Administrator", "iDRAC"
  createdAt   DateTime @default(now())

  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  @@id([assetId, vaultItemId])
  @@map("asset_vault_links")
}

enum VaultPermissionLevel {
  VIEW
  REVEAL
  COPY
  EDIT
  SHARE
}

model VaultShare {
  id          String               @id @default(uuid()) @db.Uuid
  vaultItemId String               @db.Uuid
  // Share target: exactly one of userId / roleId / departmentId
  userId       String? @db.Uuid
  roleId       String? @db.Uuid
  departmentId String? @db.Uuid
  permission   VaultPermissionLevel @default(VIEW)
  sharedById   String  @db.Uuid
  // Temporary access window
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vaultItem  VaultItem   @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)
  user       User?       @relation("SharedWithUser", fields: [userId], references: [id])
  role       Role?       @relation("SharedWithRole", fields: [roleId], references: [id])
  department Department? @relation("SharedWithDepartment", fields: [departmentId], references: [id])
  sharedBy   User        @relation("SharedBy", fields: [sharedById], references: [id])

  @@index([vaultItemId])
  @@index([userId])
  @@map("vault_shares")
}

model VaultFavorite {
  userId      String   @db.Uuid
  vaultItemId String   @db.Uuid
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id], onDelete: Cascade)

  @@id([userId, vaultItemId])
  @@map("vault_favorites")
}

// Vault access log — append-only; NEVER stores secret values.
model VaultAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  vaultItemId String   @db.Uuid
  userId      String   @db.Uuid
  action      String // VIEW_SECRET, REVEAL_SECRET, COPY_SECRET, ...
  result      String   @default("SUCCESS") // SUCCESS | DENIED
  reason      String?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])

  @@index([organizationId, vaultItemId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@map("vault_access_logs")
}

model VaultRotationLog {
  id          String   @id @default(uuid()) @db.Uuid
  vaultItemId String   @db.Uuid
  rotatedById String?  @db.Uuid
  status      String // ROTATED | VERIFIED | SKIPPED
  reason      String?
  createdAt   DateTime @default(now())

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])

  @@index([vaultItemId])
  @@map("vault_rotation_logs")
}

enum EmergencyStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  USED
}

model VaultEmergencyRequest {
  id          String          @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  vaultItemId String          @db.Uuid
  requesterId String          @db.Uuid
  reason      String
  status      EmergencyStatus @default(PENDING)
  approvedById String?        @db.Uuid
  decidedAt   DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vaultItem VaultItem @relation(fields: [vaultItemId], references: [id])
  requester User      @relation("EmergencyRequester", fields: [requesterId], references: [id])

  @@index([organizationId, status])
  @@map("vault_emergency_requests")
}

// Metadata about org encryption keys (never key material)
model EncryptionKeyMetadata {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  provider       String // gcp | local
  keyRing        String?
  cryptoKey      String?
  keyVersion     String?
  rotatedAt      DateTime?
  createdAt      DateTime @default(now())

  @@map("encryption_key_metadata")
}

// ============================================================
// Licenses & Subscriptions
// ============================================================

model License {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  softwareName   String
  vendorId       String?   @db.Uuid
  licenseType    String? // PERPETUAL, SUBSCRIPTION, OEM, VOLUME
  // License key encrypted like a vault secret when sensitive
  licenseKeyEnc  String?
  licenseKeyIv   String?
  licenseKeyTag  String?
  licenseKeyDekEnc String?
  totalSeats     Int       @default(1)
  purchaseDate   DateTime?
  startDate      DateTime?
  expiresAt      DateTime?
  cost           Decimal?  @db.Decimal(14, 2)
  renewalCost    Decimal?  @db.Decimal(14, 2)
  autoRenewal    Boolean   @default(false)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  assignments  LicenseAssignment[]

  @@index([organizationId, expiresAt])
  @@index([vendorId], map: "licenses_vendorId_idx")
  @@map("licenses")
}

model LicenseAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  licenseId  String    @db.Uuid
  employeeId String    @db.Uuid
  assignedAt DateTime  @default(now())
  revokedAt  DateTime?

  license  License  @relation(fields: [licenseId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([licenseId])
  @@index([employeeId])
  @@map("license_assignments")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  serviceName    String
  vendorId       String?            @db.Uuid
  plan           String?
  quantity       Int                @default(1)
  cost           Decimal?           @db.Decimal(14, 2)
  billingCycle   String? // MONTHLY, YEARLY
  startDate      DateTime?
  renewalDate    DateTime?
  ownerId        String?            @db.Uuid
  status         SubscriptionStatus @default(ACTIVE)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  @@index([organizationId, renewalDate])
  @@index([vendorId], map: "subscriptions_vendorId_idx")
  @@map("subscriptions")
}

// ============================================================
// Vendors, Maintenance, Procurement
// ============================================================

model Vendor {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  category       String?
  rating         Int?
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  assets       Asset[]
  licenses     License[]
  subscriptions Subscription[]
  maintenance  MaintenanceTicket[]
  purchaseRequests PurchaseRequest[]
  networkDevices NetworkDevice[]
  contracts    Contract[]

  @@index([organizationId])
  @@map("vendors")
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  WAITING_PART
  WAITING_VENDOR
  COMPLETED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceType {
  CORRECTIVE
  PREVENTIVE
}

model MaintenanceTicket {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  ticketNumber   String
  assetId        String              @db.Uuid
  problem        String
  reportedById   String?             @db.Uuid
  technicianId   String?             @db.Uuid
  vendorId       String?             @db.Uuid
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus   @default(OPEN)
  type           MaintenanceType     @default(CORRECTIVE)
  scheduledDate  DateTime?           @db.Date
  recurrenceDays Int?
  nextDueAt      DateTime?           @db.Date
  diagnosis      String?
  repairCost     Decimal?            @db.Decimal(14, 2)
  parts          String?
  remark         String?
  startedAt      DateTime?
  completedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status])
  @@index([organizationId, assetId], map: "asset_maintenance_org_assetId_idx")
  @@index([vendorId], map: "asset_maintenance_vendorId_idx")
  @@map("asset_maintenance")
}

enum PurchaseStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_IT
  PENDING_FINANCE
  APPROVED
  REJECTED
  ORDERED
  RECEIVED
  REGISTERED
  CANCELLED
}

model PurchaseRequest {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  requestNumber  String
  requesterId    String?        @db.Uuid
  departmentId   String?        @db.Uuid
  vendorId       String?        @db.Uuid
  reason         String?
  status         PurchaseStatus @default(DRAFT)
  totalEstimated Decimal?       @db.Decimal(14, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
  vendor       Vendor?        @relation(fields: [vendorId], references: [id])
  items        PurchaseItem[]
  approvals    Approval[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@map("purchase_requests")
}

model PurchaseItem {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseRequestId String  @db.Uuid
  description       String
  quantity          Int     @default(1)
  estimatedCost     Decimal? @db.Decimal(14, 2)

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @db.Uuid
  // What is being approved
  subjectType       String // PURCHASE_REQUEST, ASSET_TRANSFER, ASSET_DISPOSAL, VAULT_EMERGENCY, VAULT_REVEAL
  subjectId         String           @db.Uuid
  step              Int              @default(1)
  stepName          String? // MANAGER, IT, FINANCE, SECURITY
  approverId        String?          @db.Uuid
  decision          ApprovalDecision @default(PENDING)
  comment           String?
  decidedAt         DateTime?
  purchaseRequestId String?          @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approver        User?            @relation("Approver", fields: [approverId], references: [id])
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])

  @@index([organizationId, subjectType, subjectId])
  @@index([approverId, decision])
  @@index([purchaseRequestId, step], map: "approvals_prId_step_idx")
  @@map("approvals")
}

// ============================================================
// Offboarding
// ============================================================

enum OffboardingStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Offboarding {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  employeeId     String            @db.Uuid
  requestedById  String?           @db.Uuid
  status         OffboardingStatus @default(OPEN)
  lastWorkDate   DateTime?
  notes          String?
  // Checklist state
  assetsReturned  Boolean @default(false)
  licensesRevoked Boolean @default(false)
  vaultRevoked    Boolean @default(false)
  accountDisabled Boolean @default(false)
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId, status])
  @@map("offboardings")
}

// ============================================================
// Notifications, Audit, Settings
// ============================================================

enum NotificationLevel {
  INFO
  WARNING
  CRITICAL
}

model Notification {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  userId         String?           @db.Uuid
  type           String // ASSET_ASSIGNED, WARRANTY_EXPIRING, LICENSE_EXPIRING, ROTATION_DUE, APPROVAL_PENDING, SECURITY_ALERT, ...
  level          NotificationLevel @default(INFO)
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, userId, readAt])
  @@index([organizationId, userId, createdAt])
  @@map("notifications")
}

// Append-only audit log. No secret values are ever written here.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  action         String // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, ASSIGN, REVEAL_SECRET, ...
  entityType     String?
  entityId       String?
  detail         Json?
  ip             String?
  userAgent      String?
  result         String   @default("SUCCESS")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  key            String
  value          Json

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("system_settings")
}

// ============================================================
// IT Support / ITSM Case Management
// Reuses existing Asset / Employee / Department / Location / User /
// Notification / AuditLog / Storage. No duplicate entities.
// ============================================================

enum CasePriority {
  P1 // Critical
  P2 // High
  P3 // Normal
  P4 // Low
}

// User-facing impact; combined with category to compute Priority.
enum CaseImpact {
  UNUSABLE // ใช้งานไม่ได้เลย
  MAJOR    // งานสำคัญได้รับผลกระทบ
  PARTIAL  // ใช้งานได้บางส่วน
  GENERAL  // ขอความช่วยเหลือทั่วไป
}

enum CaseUrgency {
  HIGH   // ต้องแก้ทันที
  MEDIUM // ปกติ
  LOW    // รอได้
}

enum CaseStatus {
  NEW
  TRIAGE
  ASSIGNED
  IN_PROGRESS
  WAITING_USER
  WAITING_VENDOR
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
  DUPLICATE
}

enum CaseSource {
  WEB
  EMAIL
  LINE
  MOBILE
  MONITORING
  MANUAL
}

enum AssignmentStrategy {
  MANUAL
  ROUND_ROBIN
  LEAST_WORKLOAD
  BY_CATEGORY
  BY_LOCATION
  BY_DEPARTMENT
  BY_PRIORITY
}

model CaseType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String // INCIDENT, SERVICE_REQUEST, ACCESS, HARDWARE, ...
  name           String
  nameTh         String?
  prefix         String // INC, REQ, ACC, SEC, ...
  description    String?
  icon           String?
  active         Boolean  @default(true)
  isSystem       Boolean  @default(false)
  sortOrder      Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  cases        SupportCase[]

  @@unique([organizationId, key])
  @@map("case_types")
}

model CaseCategory {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  nameTh         String?
  parentId       String?       @db.Uuid
  assignTeamId   String?       @db.Uuid
  defaultPriority CasePriority?
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  parent       CaseCategory?  @relation("CaseCategoryTree", fields: [parentId], references: [id])
  children     CaseCategory[] @relation("CaseCategoryTree")
  assignTeam   SupportTeam?   @relation(fields: [assignTeamId], references: [id])
  casesAsCategory    SupportCase[] @relation("CaseCategory")
  casesAsSubcategory SupportCase[] @relation("CaseSubcategory")

  @@index([organizationId, parentId])
  @@map("case_categories")
}

model SlaPolicy {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  priority       CasePriority
  firstResponseMins Int
  resolutionMins    Int
  warnBeforeMins    Int      @default(15)
  pauseOnWaitingUser   Boolean @default(true)
  pauseOnWaitingVendor Boolean @default(true)
  businessHoursOnly    Boolean @default(false)
  escalateToRoleKey    String? // role key to escalate to on breach/warning

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, priority])
  @@map("sla_policies")
}

model Holiday {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  date           DateTime @db.Date
  name           String

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@map("holidays")
}

model SupportTeam {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  nameTh         String?
  description    String?
  active         Boolean  @default(true)
  // Round-robin cursor
  lastAssignedIndex Int   @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  members      SupportTeamMember[]
  cases        SupportCase[]
  categories   CaseCategory[]

  @@map("support_teams")
}

model SupportTeamMember {
  teamId String @db.Uuid
  userId String @db.Uuid

  team SupportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("support_team_members")
}

model SupportCase {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  caseNumber     String
  subject        String
  description    String

  typeId        String? @db.Uuid
  categoryId    String? @db.Uuid
  subcategoryId String? @db.Uuid

  priority           CasePriority @default(P3)
  priorityOverridden Boolean      @default(false)
  impact             CaseImpact?
  urgency            CaseUrgency?
  isMajorIncident    Boolean     @default(false)
  incidentCommanderId String?    @db.Uuid
  commsLog           String?
  status             CaseStatus   @default(NEW)
  source             CaseSource   @default(WEB)

  // Requester = the person the case is FOR (may differ from creator)
  requesterId         String? @db.Uuid
  requesterEmployeeId String? @db.Uuid
  onBehalf            Boolean @default(false)
  createdById         String? @db.Uuid

  // Reporter identity captured on the form (name + staff ID of the person
  // reporting). For public web-intake (no account) and to record the reporter
  // explicitly on internal cases even when opened on someone's behalf.
  reporterName         String?
  reporterEmail        String?
  reporterPhone        String?
  reporterEmployeeCode String?

  departmentId String? @db.Uuid
  locationId   String? @db.Uuid
  assetId      String? @db.Uuid

  assignedTeamId String? @db.Uuid
  assignedUserId String? @db.Uuid

  // SLA tracking
  firstResponseDueAt   DateTime?
  resolutionDueAt      DateTime?
  firstRespondedAt     DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  slaPausedAt          DateTime?
  slaPausedMs          BigInt    @default(0)
  firstResponseBreached Boolean  @default(false)
  resolutionBreached    Boolean  @default(false)
  slaWarned             Boolean  @default(false)

  resolutionNote String?
  reopenCount    Int     @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  type         CaseType?     @relation(fields: [typeId], references: [id])
  category     CaseCategory? @relation("CaseCategory", fields: [categoryId], references: [id])
  subcategory  CaseCategory? @relation("CaseSubcategory", fields: [subcategoryId], references: [id])
  requester    User?         @relation("CaseRequester", fields: [requesterId], references: [id])
  requesterEmployee Employee? @relation("CaseRequesterEmployee", fields: [requesterEmployeeId], references: [id])
  createdBy    User?         @relation("CaseCreatedBy", fields: [createdById], references: [id])
  department   Department?   @relation("CaseDepartment", fields: [departmentId], references: [id])
  location     Location?     @relation("CaseLocation", fields: [locationId], references: [id])
  asset        Asset?        @relation("CaseAsset", fields: [assetId], references: [id])
  assignedTeam SupportTeam?  @relation(fields: [assignedTeamId], references: [id])
  assignedUser User?         @relation("CaseAssignee", fields: [assignedUserId], references: [id])
  incidentCommander User?    @relation("CaseCommander", fields: [incidentCommanderId], references: [id])
  problemId    String?       @db.Uuid
  problem      Problem?      @relation(fields: [problemId], references: [id])

  comments     CaseComment[]
  attachments  CaseAttachment[]
  events       CaseEvent[]
  satisfaction CaseSatisfaction?

  @@unique([organizationId, caseNumber])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, requesterId, status])
  @@index([organizationId, priority, status])
  @@index([organizationId, resolutionDueAt])
  @@map("support_cases")
}

model CaseComment {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @db.Uuid
  authorId  String?  @db.Uuid
  body      String
  // Internal work log (agents only) vs user-visible conversation
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  case        SupportCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      User?            @relation(fields: [authorId], references: [id])
  attachments CaseAttachment[]

  @@index([caseId, createdAt])
  @@map("case_comments")
}

model CaseAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  caseId       String   @db.Uuid
  commentId    String?  @db.Uuid
  name         String
  storagePath  String
  contentType  String?
  sizeBytes    Int?
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  case    SupportCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  comment CaseComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_attachments")
}

// Immutable case timeline (status changes, assignment, SLA events, ...)
model CaseEvent {
  id         String     @id @default(uuid()) @db.Uuid
  caseId     String     @db.Uuid
  actorId    String?    @db.Uuid
  action     String // CREATED, TRIAGE, ASSIGNED, STATUS_CHANGE, PRIORITY_CHANGE, SLA_WARNING, SLA_BREACH, ESCALATED, RESOLVED, REOPENED, CLOSED, COMMENT
  fromStatus CaseStatus?
  toStatus   CaseStatus?
  detail     Json?
  createdAt  DateTime   @default(now())

  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("case_events")
}

model CaseSatisfaction {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @unique @db.Uuid
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  case SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_satisfactions")
}

// ---------------- IT Support KPI / Performance ----------------

enum KpiMetric {
  CLOSED_TICKETS       // higher is better (count in period)
  SLA_COMPLIANCE       // higher is better (% not breached)
  AVG_RESOLUTION_HOURS // lower is better (hours)
  CSAT                 // higher is better (1-5 avg)
  BACKLOG              // lower is better (open tickets, point-in-time)
}

/// Per-org KPI target + weight for the IT Support performance scorecard.
/// Direction (higher/lower better) is derived from the metric in code.
model KpiConfig {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  metric         KpiMetric
  target         Float
  weight         Int       @default(0) // percent; active weights should sum to 100
  active         Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric])
  @@index([organizationId])
  @@map("kpi_configs")
}

// ---------------- Email Signature Generator ----------------

/// Admin-managed signature template: branding + defaults for the whole org.
model SignatureTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)

  // Branding / layout config
  companyName    String?
  logoUrl        String?
  primaryColor   String   @default("#24386F")
  secondaryColor String   @default("#6b7280")
  fontFamily     String   @default("Arial, Helvetica, sans-serif")
  fontSize       Int      @default(13)
  dividerStyle   String   @default("solid") // solid | dashed | none
  /// Default company links: [{ name, url, icon? }]
  defaultLinks   Json     @default("[]")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profiles     SignatureProfile[]

  @@index([organizationId])
  @@map("signature_templates")
}

/// A user's own signature content (auto-populated from their profile/employee).
model SignatureProfile {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  userId         String  @unique @db.Uuid
  templateId     String? @db.Uuid

  fullName    String
  position    String?
  department  String?
  mobilePhone String?
  officePhone String?
  extension   String?
  email       String?
  website     String?
  address     String?
  logoUrl     String?
  /// Per-user company links: [{ name, url, icon? }]
  companyLinks Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     SignatureTemplate? @relation(fields: [templateId], references: [id])

  @@index([organizationId])
  @@map("signature_profiles")
}

// ------------------------------------------------------------------
// IT Support Report Center — daily IT health monitoring
// ------------------------------------------------------------------

enum ItSystemCategory {
  SERVER
  BACKUP
  STORAGE
  CCTV
  PHONE
  GPS
  LOG
  MANGO_LOGIN
  MANGO_USAGE
  OTHER
}

/// Health of a monitored item: 🟢 NORMAL, 🟡 WARNING, 🔴 CRITICAL, ⚪ NOT_CHECKED
enum ItHealthStatus {
  NORMAL
  WARNING
  CRITICAL
  NOT_CHECKED
}

/// How the data is obtained / trust level: 🟢 AUTO (system pulled it),
/// 🟡 CHECK_REQUIRED (IT must verify), 🔴 ISSUE (problem needing action).
enum ItReportMode {
  AUTO
  CHECK_REQUIRED
  ISSUE
}

model ItHealthCheck {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  checkDate      DateTime         @db.Date
  category       ItSystemCategory
  name           String
  locationId     String?          @db.Uuid
  mode           ItReportMode     @default(CHECK_REQUIRED)
  status         ItHealthStatus   @default(NOT_CHECKED)
  healthPercent  Int?
  /// Flexible per-category metrics, e.g. { cpu, ram, storage } / { lastBackup, size, result } / { online, recording }
  metrics        Json?
  note           String?
  /// When an issue is opened for this finding, the linked SupportCase id.
  issueCaseId    String?          @db.Uuid
  checkedById    String?          @db.Uuid
  verifiedById   String?          @db.Uuid
