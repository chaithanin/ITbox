// ============================ CCTV Monitoring ============================
// Read-only monitoring of Dahua (and, later, other-brand) NVR/XVR recorders and
// their camera channels. The device-facing engine runs as an on-prem collector
// that pushes health/recording/storage data to /api/cctv/ingest. Credentials are
// stored envelope-encrypted (never in plaintext, logs, UI, or API responses).

enum CctvDeviceStatus {
  ONLINE
  OFFLINE
  AUTH_ERROR
  NETWORK_ERROR
  TIMEOUT
  UNKNOWN
}

enum CctvCameraStatus {
  ONLINE
  OFFLINE
  VIDEO_LOSS
  NO_RECORDING
  STREAM_ERROR
  AUTH_ERROR
  NETWORK_ERROR
  DEGRADED
  UNKNOWN
}

enum CctvRecordingStatus {
  RECORDING
  NOT_RECORDING
  NO_RECORDING_FOUND
  UNKNOWN
}

enum CctvStorageStatus {
  NORMAL
  WARNING
  CRITICAL
  FAILED
  UNKNOWN
}

enum CctvIncidentType {
  RECORDER_OFFLINE
  CAMERA_OFFLINE
  VIDEO_LOSS
  NO_RECORDING
  RECORDING_GAP
  HDD_ERROR
  HDD_FULL
  LOW_RETENTION
  AUTH_FAILURE
  MONITORING_FAILURE
}

enum CctvIncidentStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum CctvSeverity {
  INFO
  WARNING
  CRITICAL
}

model CctvRecorder {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  name           String
  serial         String // Dahua device serial / P2P id (the device.xml `domain`)
  project        String?
  site           String?
  building       String?
  floor          String?
  area           String?
  localIp        String?
  deviceType     String?
  model          String?
  firmware       String?
  tcpPort        Int              @default(37777)
  httpPort       Int?
  httpsPort      Int?
  rtspPort       Int?
  protocol       String?
  username       String?
  // Envelope-encrypted credential (AES-256-GCM + KMS-wrapped DEK). Never revealed.
  credentialEnc     String?
  credentialIv      String?
  credentialTag     String?
  credentialDekEnc  String?
  credentialKeyVer  String?
  channelCount   Int?
  capabilities   Json?
  status         CctvDeviceStatus @default(UNKNOWN)
  lastSeenAt     DateTime?
  lastOnlineAt   DateTime?
  offlineSince   DateTime?
  failureCount   Int              @default(0)
  errorMessage   String?
  recheckRequestedAt DateTime? // set by "Check Now"; cleared by the collector on next poll
  assetId        String?          @db.Uuid
  locationId     String?          @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  asset        Asset?       @relation(fields: [assetId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  cameras      CctvCamera[]
  healthLogs   CctvHealthLog[]
  storageLogs  CctvStorageLog[]
  incidents    CctvIncident[]

  @@unique([organizationId, serial])
  @@index([organizationId, status])
  @@index([organizationId, project])
  @@index([assetId], map: "cctv_recorders_assetId_idx")
  @@map("cctv_recorders")
}

model CctvCamera {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  recorderId     String              @db.Uuid
  channel        Int
  name           String?
  cameraIp       String?
  model          String?
  serial         String?
  status         CctvCameraStatus    @default(UNKNOWN)
  streamStatus   String?
  recordingStatus CctvRecordingStatus @default(UNKNOWN)
  latestRecordingAt   DateTime?
  earliestRecordingAt DateTime?
  recordingGapSeconds Int?
  retentionDays  Float?
  retentionEstimated  Boolean         @default(false)
  lastSnapshotAt   DateTime?
  lastSnapshotPath String?
  snapshotObjectKey String? // storage object key for the uploaded JPEG (served via API)
  lastSnapshotW    Int?
  lastSnapshotH    Int?
  lastOnlineAt   DateTime?
  offlineSince   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  recorder     CctvRecorder    @relation(fields: [recorderId], references: [id], onDelete: Cascade)
  healthLogs   CctvHealthLog[]
  incidents    CctvIncident[]

  @@unique([recorderId, channel])
  @@index([organizationId, status])
  @@map("cctv_cameras")
}

model CctvHealthLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  recorderId     String   @db.Uuid
  cameraId       String?  @db.Uuid
  checkedAt      DateTime @default(now())
  deviceStatus   CctvDeviceStatus?
  cameraStatus   CctvCameraStatus?
  streamStatus   String?
  recordingStatus CctvRecordingStatus?
  latestRecordingAt   DateTime?
  recordingGapSeconds Int?
  snapshotStatus String?
  snapshotPath   String?
  latencyMs      Int?
  errorCode      String?
  errorMessage   String?

  organization Organization @relation(fields: [organizationId], references: [id])
  recorder     CctvRecorder @relation(fields: [recorderId], references: [id], onDelete: Cascade)
  camera       CctvCamera?  @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedAt])
  @@index([recorderId, checkedAt])
  @@index([cameraId, checkedAt])
  @@map("cctv_health_logs")
}

model CctvStorageLog {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  recorderId     String            @db.Uuid
  checkedAt      DateTime          @default(now())
  hddIndex       Int
  hddModel       String?
  status         CctvStorageStatus @default(UNKNOWN)
  capacityBytes  BigInt?
  usedBytes      BigInt?
  freeBytes      BigInt?
  temperatureC   Int?
  smartStatus    String?

  organization Organization @relation(fields: [organizationId], references: [id])
  recorder     CctvRecorder @relation(fields: [recorderId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedAt])
  @@index([recorderId, checkedAt])
  @@map("cctv_storage_logs")
}

model CctvIncident {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  recorderId     String?            @db.Uuid
  cameraId       String?            @db.Uuid
  type           CctvIncidentType
  severity       CctvSeverity       @default(WARNING)
  status         CctvIncidentStatus @default(OPEN)
  title          String
  detail         String?
  startedAt      DateTime           @default(now())
  detectedAt     DateTime           @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  downtimeMinutes Int?
  rootCause      String?
  resolution     String?
  responsiblePerson String?
  ticketNumber   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  recorder     CctvRecorder? @relation(fields: [recorderId], references: [id], onDelete: SetNull)
  camera       CctvCamera?   @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, type])
  @@map("cctv_incidents")
}

// ============================================================
// IT Asset Borrowing & Return Management
// Temporary loan lifecycle (distinct from permanent AssetAssignment):
//   Request → multi-step approval → issue/handover → return/inspection.
// The DB is the source of truth; the A4 company-form PDF is rendered from it.
// ============================================================

enum BorrowRequestStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_IT
  PENDING_MANAGEMENT
  APPROVED
  REJECTED
  READY_TO_ISSUE
  ISSUED
  PARTIALLY_RETURNED
  RETURNED
  CLOSED
  CANCELLED
}

enum BorrowApprovalStep {
  MANAGER
  IT
  MANAGEMENT
}

enum BorrowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum BorrowItemStatus {
  PENDING
  ISSUED
  RETURNED
  DAMAGED
  LOST
}

// Condition grade captured on the physical handover / return form.
enum LoanCondition {
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  OTHER
}

enum InspectionResult {
  COMPLETE
  DAMAGED
  MISSING_ACCESSORY
  REPAIR_REQUIRED
  LOST
}

enum SignatureType {
  NONE
  DRAWN
  TYPED
  UPLOADED
}

enum SignatureRole {
  REQUESTER
  DEPT_MANAGER
  IT_RECEIVER
  IT_HANDOVER
  IT_MANAGER
  MANAGEMENT
  RETURNER
  RETURN_RECEIVER
}

enum ConditionPhotoPhase {
  BEFORE
  AFTER
}

model BorrowRequest {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  refNo          String // IT-BR-2026-0001
  refYear        Int
  refSeq         Int

  requesterEmployeeId String  @db.Uuid
  departmentId        String? @db.Uuid
  // Snapshot of requester contact at submit time (auto-populated from master;
  // frozen so the printed form reflects the state when it was signed).
  requesterName     String?
  requesterPosition String?
  requesterPhone    String?
  requesterEmail    String?

  purpose    String?
  useLocation String? // where the asset will be used
  borrowDate DateTime?
  dueDate    DateTime?

  status         BorrowRequestStatus @default(DRAFT)
  currentStep    BorrowApprovalStep?
  submittedAt    DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?
  issuedAt       DateTime?
  returnedAt     DateTime?
  closedAt       DateTime?
  cancelledAt    DateTime?
  notes          String?

  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  updatedAt   DateTime  @updatedAt
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  requester  Employee    @relation("BorrowRequester", fields: [requesterEmployeeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  items      BorrowRequestItem[]
  approvals  BorrowApproval[]
  issues     AssetIssueRecord[]
  returns    AssetReturnRecord[]
  signatures DigitalSignature[]

  @@unique([organizationId, refNo])
  @@index([organizationId, status])
  @@index([organizationId, requesterEmployeeId])
  @@index([organizationId, dueDate])
  @@map("borrow_requests")
}

model BorrowRequestItem {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  borrowRequestId String           @db.Uuid
  assetId         String           @db.Uuid
  status          BorrowItemStatus @default(PENDING)
  quantity        Int              @default(1)
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrowRequest BorrowRequest     @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)
  asset         Asset             @relation(fields: [assetId], references: [id])
  issueItems    AssetIssueItem[]
  returnItems   AssetReturnItem[]

  @@index([organizationId, borrowRequestId])
  @@index([organizationId, assetId])
  @@map("borrow_request_items")
}

model BorrowApproval {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @db.Uuid
  borrowRequestId String               @db.Uuid
  step            BorrowApprovalStep
  sequence        Int
  status          BorrowApprovalStatus @default(PENDING)
  approverUserId  String?              @db.Uuid
  approverName    String?
  comment         String?
  decidedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  borrowRequest BorrowRequest @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, borrowRequestId])
  @@map("borrow_approvals")
}

model AssetIssueRecord {
  id                   String  @id @default(uuid()) @db.Uuid
  organizationId       String  @db.Uuid
  borrowRequestId      String  @db.Uuid
  issuedById           String? @db.Uuid // IT staff handing over
  issuedByName         String?
  receivedByEmployeeId String? @db.Uuid // borrower receiving
  receivedByName       String?
  issuedAt             DateTime @default(now())
  note                 String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  borrowRequest BorrowRequest    @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)
  items         AssetIssueItem[]

  @@index([organizationId, borrowRequestId])
  @@map("asset_issue_records")
}

model AssetIssueItem {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  issueRecordId   String        @db.Uuid
  borrowItemId    String        @db.Uuid
  assetId         String        @db.Uuid
  conditionBefore LoanCondition @default(GOOD)
  conditionNote   String?
  serialSnapshot  String?

  createdAt DateTime @default(now())

  issueRecord AssetIssueRecord      @relation(fields: [issueRecordId], references: [id], onDelete: Cascade)
  borrowItem  BorrowRequestItem     @relation(fields: [borrowItemId], references: [id])
  photos      AssetConditionPhoto[]

  @@index([organizationId, issueRecordId])
  @@map("asset_issue_items")
}

model AssetReturnRecord {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @db.Uuid
  borrowRequestId      String           @db.Uuid
  returnedByEmployeeId String?          @db.Uuid
  returnedByName       String?
  receivedById         String?          @db.Uuid // IT staff receiving return
  receivedByName       String?
  returnedAt           DateTime         @default(now())
  inspectionResult     InspectionResult @default(COMPLETE)
  note                 String?

  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  borrowRequest BorrowRequest     @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)
  items         AssetReturnItem[]

  @@index([organizationId, borrowRequestId])
  @@map("asset_return_records")
}

model AssetReturnItem {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  returnRecordId      String           @db.Uuid
  borrowItemId        String           @db.Uuid
  assetId             String           @db.Uuid
  conditionAfter      LoanCondition    @default(GOOD)
  inspectionResult    InspectionResult @default(COMPLETE)
  accessoriesComplete Boolean          @default(true)
  accessoriesNote     String?
  damageNote          String?

  createdAt DateTime @default(now())

  returnRecord AssetReturnRecord     @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  borrowItem   BorrowRequestItem     @relation(fields: [borrowItemId], references: [id])
  photos       AssetConditionPhoto[]

  @@index([organizationId, returnRecordId])
  @@map("asset_return_items")
}

model AssetConditionPhoto {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  phase          ConditionPhotoPhase
  issueItemId    String?             @db.Uuid
  returnItemId   String?             @db.Uuid
  storagePath    String
  contentType    String?
  sizeBytes      Int?
  caption        String?
  uploadedById   String?             @db.Uuid

  createdAt DateTime @default(now())

  issueItem  AssetIssueItem?  @relation(fields: [issueItemId], references: [id], onDelete: Cascade)
  returnItem AssetReturnItem? @relation(fields: [returnItemId], references: [id], onDelete: Cascade)

  @@index([organizationId, issueItemId])
  @@index([organizationId, returnItemId])
  @@map("asset_condition_photos")
}

model DigitalSignature {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  borrowRequestId String        @db.Uuid
  role            SignatureRole
  phase           String? // REQUEST / ISSUE / RETURN
  signatureType   SignatureType @default(NONE)
  signatureImage  String? // storage path to a drawn/uploaded signature
  signedByUserId  String?       @db.Uuid
  signedByName    String?
  signedAt        DateTime?
  ipAddress       String?

  createdAt DateTime @default(now())

  borrowRequest BorrowRequest @relation(fields: [borrowRequestId], references: [id], onDelete: Cascade)

  @@index([organizationId, borrowRequestId])
  @@map("digital_signatures")
}

// ============================ SIM / phone-line registry ============================

enum SimStatus {
  ACTIVE
  UNUSED
  SUSPENDED
  TERMINATED
}

model SimCard {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  phoneNumber    String
  carrier        String    // AIS, DTAC, TRUE, OTHER
  accountName    String?   // billing account / group, e.g. GTG, Heliton
  holder         String?   // free-text holder / purpose from the registry
  employeeId     String?   @db.Uuid
  departmentId   String?   @db.Uuid
  status         SimStatus @default(ACTIVE)
  simSerial      String?
  plan           String?
  monthlyFee     Decimal?  @db.Decimal(12, 2)
  startDate      DateTime?
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, phoneNumber])
  @@index([organizationId, status])
  @@map("sim_cards")
}
